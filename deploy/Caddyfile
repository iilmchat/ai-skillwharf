# Production edge: Caddy терминирует TLS и проксирует на web:80.
# Сертификаты Let's Encrypt выпускаются автоматически при доступности
# домена по портам 80/443.
{
	email {$ACME_EMAIL}
	# По умолчанию production-CA; staging-оверрайд подставляет staging-CA.
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

{$DOMAIN} {
	encode zstd gzip

	# Telegram webhook идёт напрямую в API, минуя web-контейнер.
	# Секрет X-Telegram-Bot-Api-Secret-Token проверяет API; Caddy только
	# терминирует TLS и не публикует внутренний порт API.
	handle /api/v1/webhooks/telegram* {
		reverse_proxy api:3000
	}

	reverse_proxy web:80
}
