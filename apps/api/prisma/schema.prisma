// Prisma schema для SkillWharf API.
// Документация: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  // native — локальная разработка (Windows/Linux), linux-musl-openssl-3.0.x — runtime в alpine.
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  // Нужен для `datasource.extensions` (pgvector) в migration SQL.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Долговременная память агента: косинусный поиск по эмбеддингам.
  extensions = [vector]
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  role            String         @default("user")
  /// Budget Guard: дневной лимит токенов LLM и расход за текущие сутки.
  dailyTokenLimit Int            @default(100000)
  dailyTokensUsed Int            @default(0)
  lastTokenReset  DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sessions        Session[]
  transactions    Transaction[]
  conversations   Conversation[]
  wallet          Wallet?
  auditLogs        AuditLog[]
  telegramChatLinks TelegramChatLink[]
  telegramBot      TelegramBot?
  googleCredential GoogleCredential?
  providerCredentials ProviderCredential[]
  ownedOrganizations Organization[] @relation("OrganizationOwner")
  workspaceMembers  WorkspaceMember[]
  installedSkills   InstalledSkill[]
}

/// Мульти-тенантная иерархия (Sprint 31 / ORG-31.1).
model Organization {
  id        String      @id @default(uuid())
  name      String
  slug      String      @unique
  ownerId   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  owner     User        @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspaces Workspace[]
}

model Workspace {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  slug           String
  isDefault      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        WorkspaceMember[]
  installedSkills InstalledSkill[]
  webhookTriggers WebhookTrigger[]
  customAgentRoles CustomAgentRole[]
  telegramChannels TelegramChannel[]
  corpMessengerChannels CorpMessengerChannel[]

  @@unique([organizationId, slug])
}

model WorkspaceMember {
  id                   String   @id @default(uuid())
  workspaceId          String
  userId               String
  role                 String   @default("viewer")
  /// Порог суммы HITL-одобрения в ₽; NULL — без ограничения (ABAC).
  hitlApprovalLimitRub Decimal? @db.Decimal(18, 2)
  createdAt            DateTime @default(now())
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Decimal
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

/// Transactional Outbox для внешних выплат Revenue Share (Sprint 33 / KI-087).
model BillingOutbox {
  id             String    @id @default(uuid())
  eventType      String    @default("yookassa_author_transfer")
  idempotencyKey String    @unique
  payloadJson    Json
  /// pending | processing | sent | failed_dead
  status         String    @default("pending")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  nextRetryAt    DateTime  @default(now())
  lastError      String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([status, nextRetryAt])
}

model Conversation {
  id        String    @id @default(uuid())
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  telegramChatLink TelegramChatLink?

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  /// Метаданные ассистента: артефакты, executionTrace, cacheHit (UX-37).
  metadataJson   Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

/// Фрагмент долговременной памяти пользователя (RAG).
/// `embedding` — pgvector; размерность должна совпадать с моделью эмбеддингов
/// (см. EMBEDDINGS_MODEL и MEMORY_EMBEDDING_DIMENSIONS в API).
model MemoryChunk {
  id        String                       @id @default(uuid())
  userId    String
  content   String
  embedding Unsupported("vector(1536)")?
  /// Источник фрагмента: chat | document | ... (KI-024).
  source    String?
  /// Тип фрагмента: fact | preference | summary (KI-024).
  kind      String   @default("fact")
  /// Папка базы знаний и происхождение документа (KB-38.1/38.2).
  folderId       String?
  documentTitle  String?
  pageNumber     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([folderId])
}

/// Папка регламентов базы знаний (KB-38.1).
model KnowledgeFolder {
  id          String   @id @default(uuid())
  workspaceId String?
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
}

model Wallet {
  id          String        @id @default(uuid())
  userId      String        @unique
  balance     Decimal       @default(0) @db.Decimal(18, 2)
  /// Средства, зарезервированные под PENDING-задачи (Pay-per-Outcome).
  heldBalance Decimal       @default(0) @db.Decimal(18, 2)
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     LedgerEntry[]
}

/// Append-only ledger: записи только создаются, не обновляются и не удаляются.
/// Исключение — перевод PENDING в debit/credit при завершении escrow.
model LedgerEntry {
  id             String   @id @default(uuid())
  walletId       String
  amount         Decimal  @db.Decimal(18, 2)
  balanceAfter   Decimal  @db.Decimal(18, 2)
  type           String
  description    String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  /// Для LLM-списаний — имя маршрута LlmRoute (бюджеты на маршрут).
  llmRouteName   String?
  wallet         Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([llmRouteName, createdAt])
}

model InstalledSkill {
  id          String   @id @default(uuid())
  /// Имя не глобально уникально: один навык может быть установлен разными
  /// пользователями/воркспейсами (KI-086, ORG-31.2).
  name        String
  version     String
  author      String
  manifest    Json
  isEnabled   Boolean  @default(true)
  /// slug навыка в публичном каталоге (API-27.2), если установлен оттуда.
  marketplaceSlug String?
  /// Per-user/per-workspace изоляция установок (KI-086, ORG-31.2).
  userId      String?
  workspaceId String?
  installedAt DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([name, userId, workspaceId])
  @@index([marketplaceSlug])
  @@index([userId])
  @@index([workspaceId])
}

/// Публичный каталог навыков (API-27.2, ADR 0002).
/// `manifestYaml` — исходный SKILL.md; подпись проверяется по доверенным
/// ключам при публикации и при установке.
model MarketplaceSkill {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  version          String
  description      String
  /// Треки A..L из матрицы монетизации.
  trackIds         String[]
  /// Владелец записи в каталоге (автор навыка).
  authorId         String
  authorName       String
  /// Счёт ЮKassa для сплита Revenue Share (не секрет).
  payoutAccountId  String?
  manifestYaml     String
  signature        String?
  publicKeyId      String?
  verified         Boolean  @default(false)
  pricingModel     String
  price            Decimal  @default(0) @db.Decimal(18, 2)
  downloadsCount   Int      @default(0)
  status           String   @default("draft")
  /// Статический аудит безопасности: passed | warning | rejected.
  auditStatus      String   @default("passed")
  /// Находки аудита: [{ severity, code, message }].
  auditFindingsJson Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([authorId])
}

/// Счётчик бесплатных вызовов навыка (Freemium).
model SkillUsage {
  id          String   @id @default(uuid())
  userId      String
  skillName   String
  callsCount  Int      @default(0)
  lastResetAt DateTime @default(now())

  @@unique([userId, skillName])
  @@index([userId])
}

/// Шаблон системного промпта; версии хранятся отдельно.
model PromptTemplate {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    PromptVersion[]
  experiments PromptExperiment[]
  evalRuns    PromptEvalRun[]
}

/// Версия содержимого промпта. Активной считается последняя версия.
model PromptVersion {
  id         String         @id @default(uuid())
  templateId String
  version    Int
  content    String
  createdAt  DateTime       @default(now())
  template   PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

/// A/B-эксперимент над версиями системного промпта (WEB-28.1 / KI-009).
/// Трафик делится детерминированно по хешу conversationId.
model PromptExperiment {
  id                String    @id @default(uuid())
  promptId          String
  name              String
  variantAVersionId String
  variantBVersionId String
  /// Доля трафика, направляемая в вариант B (0..100).
  trafficSplitB     Int
  status            String    @default("running")
  winnerVersionId   String?
  /// Агрегаты: запросы, средняя latency (мс), средняя стоимость (₽) по A/B.
  metricsJson       Json?
  createdAt         DateTime  @default(now())
  stoppedAt         DateTime?
  prompt            PromptTemplate @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId, status])
}

/// Прогон автоматической оценки качества версии промпта (EVAL-29.2/29.3).
/// `resultsJson` — детализация по каждому кейсу (метрики и вердикт судьи).
model PromptEvalRun {
  id           String    @id @default(uuid())
  promptId     String
  versionId    String
  /// Фильтр трека A..L; NULL — весь датасет.
  trackFilter  String?
  totalCases   Int
  passedCases  Int
  passRate     Float
  avgScore     Float
  status       String    @default("running")
  resultsJson  Json?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  prompt       PromptTemplate @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId, createdAt])
  @@index([versionId, status])
}

/// Правило выбора LLM-провайдера. Меньший priority выбирается первым.
model LlmRoute {
  id           String   @id @default(uuid())
  name         String   @unique
  modelName    String
  /// OpenAI | YandexGPT | GigaChat
  providerType String   @default("OpenAI")
  baseUrl      String
  apiKeyEnvVar String?
  priority     Int      @default(0)
  isActive     Boolean  @default(true)
  /// Тип задачи маршрута: chat | embeddings | ... (fallback — в рамках одного).
  taskType     String   @default("chat")
  /// Дневной лимит затрат на маршрут (₽). NULL — без лимита.
  dailyCostLimit Decimal? @db.Decimal(18, 2)
  /// Per-model тарифы (₽ за 1000 токенов). NULL — fallback на env/JSON.
  inputCostPer1k  Decimal? @db.Decimal(18, 6)
  outputCostPer1k Decimal? @db.Decimal(18, 6)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, taskType, priority])
}

/// Сохранённое состояние LangGraph (checkpointer) после супершага.
/// `payload` и `metadata` — сериализация JsonPlus (`serde.dumpsTyped`),
/// поэтому хранятся как BYTEA, а не как JSONB: формат не обязан быть JSON.
model GraphCheckpoint {
  id                 String   @id @default(uuid())
  threadId           String
  checkpointNs       String   @default("")
  checkpointId       String
  parentCheckpointId String?
  payload            Bytes    @db.ByteA
  metadata           Bytes    @db.ByteA
  createdAt          DateTime @default(now())

  @@unique([threadId, checkpointNs, checkpointId])
  @@index([threadId, checkpointId])
}

/// Отложенные записи каналов (pending writes) для конкретной точки графа.
/// `idx` отрицательный для служебных каналов (`WRITES_IDX_MAP`).
model GraphCheckpointWrite {
  id           String   @id @default(uuid())
  threadId     String
  checkpointNs String   @default("")
  checkpointId String
  taskId       String
  idx          Int
  taskPath     String   @default("")
  channel      String
  value        Bytes    @db.ByteA
  createdAt    DateTime @default(now())

  @@unique([threadId, checkpointNs, checkpointId, taskId, idx])
  @@index([threadId, checkpointNs, checkpointId])
}

/// Входящий вебхук-триггер Event-Driven агентов (CONNECT-32.2).
model WebhookTrigger {
  id              String    @id @default(uuid())
  workspaceId     String
  userId          String
  name            String
  slug            String    @unique
  source          String
  /// Секрет заголовка X-Trigger-Secret (только хеш/значение в БД, не в логах).
  secretToken     String
  promptTemplate  String
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  triggerCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

/// Подключение Telegram-бота к воркспейсу (OMNI-39.1).
model TelegramChannel {
  id               String    @id @default(cuid())
  workspaceId      String
  userId           String
  botUsername      String?
  /// Bot Token в envelope TokenCipherService — никогда не в логах/GET.
  encryptedBotToken String
  /// Секрет заголовка X-Telegram-Bot-Api-Secret-Token.
  webhookSecret    String
  /// Белый список chat_id; пустой — разрешён первый привязанный чат.
  allowedChatIds   String[]
  isActive         Boolean   @default(true)
  lastMessageAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, botUsername])
  @@index([workspaceId])
  @@index([userId])
}

/// Подключение корпоративного мессенджера (OMNI-40.1/40.2/40.3/40.4).
model CorpMessengerChannel {
  id                String    @id @default(cuid())
  workspaceId       String
  userId            String
  /// vk_teams | pachca | yandex_messenger.
  provider          String
  name              String
  /// On-premise VK Teams или кастомный стенд.
  apiBaseUrl        String?
  /// Bot Token в envelope TokenCipherService — не в логах/GET.
  encryptedBotToken String
  webhookSecret     String
  allowedChatIds    String[]
  isActive          Boolean   @default(true)
  lastMessageAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([provider])
}

/// Действие агента, ожидающее решения пользователя (approval или оплата).
/// Пишется до `interrupt()`, чтобы после рестарта API был известен контекст.
model PendingApproval {
  id             String    @id @default(uuid())
  conversationId String    @unique
  userId         String
  /// approval | payment
  reason         String
  /// string[] — инструменты, ожидающие подтверждения.
  tools          Json
  /// {callId,toolName,entryId}[] — зарезервированные escrow-holds.
  holds          Json
  /// pending | approved | rejected | expired
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  /// Дедлайн решения: после него фоновый job отменяет hold и чистит checkpoint.
  expiresAt      DateTime?

  @@index([userId, status, createdAt])
  @@index([status, expiresAt])
}

/// Зашифрованные OAuth-токены Google Workspace.
/// `accessToken`/`refreshToken` — envelope `v2:<keyId>:<iv>:<tag>:<ciphertext>`;
/// открытые значения в БД не попадают. Ключ — TOKEN_ENCRYPTION_KEY или KMS.
model GoogleCredential {
  userId       String   @id
  accessToken  String
  refreshToken String?
  scope        String
  /// Email аккаунта Google (из id_token) для отображения в UI.
  email        String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Telegram-бот, подключённый пользователем (Bot Token из BotFather).
/// Токен хранится зашифрованным; `send_message` использует бота пользователя,
/// а если его нет — системного бота из `TELEGRAM_BOT_TOKEN`.
model TelegramBot {
  userId      String   @id
  token       String
  botId       String
  botUsername String?
  botName     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Привязка Telegram-чата к пользователю и диалогу SkillWharf.
/// `chatId` — идентификатор чата Telegram, уникален глобально.
model TelegramChatLink {
  chatId         String       @id
  userId         String
  conversationId String       @unique
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Ключи Ozon/Wildberries/Midjourney, подключённые пользователем.
///
/// `secret` — envelope `v2:<keyId>:<iv>:<tag>:<ciphertext>` (AES-256-GCM,
/// `TOKEN_ENCRYPTION_KEY`) с JSON полезной нагрузки:
/// Ozon — `{clientId, apiKey}`, WB — `{apiToken}`, Midjourney — `{apiKey}`.
/// Открытых секретов в БД нет. `metadata` — только неконфиденциальные поля
/// для UI (например, срок действия токена WB).
model ProviderCredential {
  userId    String
  /// `ozon` | `wildberries` | `midjourney` | `bitrix24` | `moysklad`
  /// (валидируется Zod в сервисе; отдельная миграция не нужна).
  provider  String
  secret    String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, provider])
  @@index([provider])
}

/// Аудит изменений Control Plane: кто, что и когда изменил.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([entityType, entityId])
}

/// Кастомная роль агента AI-Офиса из No-Code конструктора (BUILDER-35.1/35.2/35.3).
model CustomAgentRole {
  id             String   @id @default(cuid())
  workspaceId    String
  /// Отображаемое название «стола» в AI-Офисе.
  name           String
  /// Латинский slug роли, уникальный в паре с воркспейсом.
  roleKey        String
  description    String?
  /// Инструкции агента (сливаются в системный промпт сессии).
  systemPrompt   String
  /// Список подключённых навыков (marketplaceSlug или имя навыка).
  skillSlugs     String[]
  /// never | high_risk | always.
  hitlPolicy     String   @default("high_risk")
  /// Лимит расходов агента в сутки; NULL — без ограничения.
  dailyBudgetRub Decimal? @db.Decimal(18, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, roleKey])
  @@index([workspaceId])
}
