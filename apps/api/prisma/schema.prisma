// Prisma schema для SkillWharf API.
// Документация: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  // native — локальная разработка (Windows/Linux), linux-musl-openssl-3.0.x — runtime в alpine.
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  // Нужен для `datasource.extensions` (pgvector) в migration SQL.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Долговременная память агента: косинусный поиск по эмбеддингам.
  extensions = [vector]
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  role            String         @default("user")
  /// Budget Guard: дневной лимит токенов LLM и расход за текущие сутки.
  dailyTokenLimit Int            @default(100000)
  dailyTokensUsed Int            @default(0)
  lastTokenReset  DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sessions        Session[]
  transactions    Transaction[]
  conversations   Conversation[]
  wallet          Wallet?
  auditLogs       AuditLog[]
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Decimal
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Conversation {
  id        String    @id @default(uuid())
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

/// Фрагмент долговременной памяти пользователя (RAG).
/// `embedding` — pgvector; размерность должна совпадать с моделью эмбеддингов
/// (см. EMBEDDINGS_MODEL и MEMORY_EMBEDDING_DIMENSIONS в API).
model MemoryChunk {
  id        String                       @id @default(uuid())
  userId    String
  content   String
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now())

  @@index([userId])
}

model Wallet {
  id          String        @id @default(uuid())
  userId      String        @unique
  balance     Decimal       @default(0) @db.Decimal(18, 2)
  /// Средства, зарезервированные под PENDING-задачи (Pay-per-Outcome).
  heldBalance Decimal       @default(0) @db.Decimal(18, 2)
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     LedgerEntry[]
}

/// Append-only ledger: записи только создаются, не обновляются и не удаляются.
/// Исключение — перевод PENDING в debit/credit при завершении escrow.
model LedgerEntry {
  id             String   @id @default(uuid())
  walletId       String
  amount         Decimal  @db.Decimal(18, 2)
  balanceAfter   Decimal  @db.Decimal(18, 2)
  type           String
  description    String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  /// Для LLM-списаний — имя маршрута LlmRoute (бюджеты на маршрут).
  llmRouteName   String?
  wallet         Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([llmRouteName, createdAt])
}

model InstalledSkill {
  id          String   @id @default(uuid())
  name        String   @unique
  version     String
  author      String
  manifest    Json
  isEnabled   Boolean  @default(true)
  installedAt DateTime @default(now())
}

/// Счётчик бесплатных вызовов навыка (Freemium).
model SkillUsage {
  id          String   @id @default(uuid())
  userId      String
  skillName   String
  callsCount  Int      @default(0)
  lastResetAt DateTime @default(now())

  @@unique([userId, skillName])
  @@index([userId])
}

/// Шаблон системного промпта; версии хранятся отдельно.
model PromptTemplate {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    PromptVersion[]
}

/// Версия содержимого промпта. Активной считается последняя версия.
model PromptVersion {
  id         String         @id @default(uuid())
  templateId String
  version    Int
  content    String
  createdAt  DateTime       @default(now())
  template   PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

/// Правило выбора LLM-провайдера. Меньший priority выбирается первым.
model LlmRoute {
  id           String   @id @default(uuid())
  name         String   @unique
  modelName    String
  /// OpenAI | YandexGPT | GigaChat
  providerType String   @default("OpenAI")
  baseUrl      String
  apiKeyEnvVar String?
  priority     Int      @default(0)
  isActive     Boolean  @default(true)
  /// Тип задачи маршрута: chat | embeddings | ... (fallback — в рамках одного).
  taskType     String   @default("chat")
  /// Дневной лимит затрат на маршрут (₽). NULL — без лимита.
  dailyCostLimit Decimal? @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, taskType, priority])
}

/// Сохранённое состояние LangGraph (checkpointer) после супершага.
/// `payload` и `metadata` — сериализация JsonPlus (`serde.dumpsTyped`),
/// поэтому хранятся как BYTEA, а не как JSONB: формат не обязан быть JSON.
model GraphCheckpoint {
  id                 String   @id @default(uuid())
  threadId           String
  checkpointNs       String   @default("")
  checkpointId       String
  parentCheckpointId String?
  payload            Bytes    @db.ByteA
  metadata           Bytes    @db.ByteA
  createdAt          DateTime @default(now())

  @@unique([threadId, checkpointNs, checkpointId])
  @@index([threadId, checkpointId])
}

/// Отложенные записи каналов (pending writes) для конкретной точки графа.
/// `idx` отрицательный для служебных каналов (`WRITES_IDX_MAP`).
model GraphCheckpointWrite {
  id           String   @id @default(uuid())
  threadId     String
  checkpointNs String   @default("")
  checkpointId String
  taskId       String
  idx          Int
  taskPath     String   @default("")
  channel      String
  value        Bytes    @db.ByteA
  createdAt    DateTime @default(now())

  @@unique([threadId, checkpointNs, checkpointId, taskId, idx])
  @@index([threadId, checkpointNs, checkpointId])
}

/// Действие агента, ожидающее решения пользователя (approval или оплата).
/// Пишется до `interrupt()`, чтобы после рестарта API был известен контекст.
model PendingApproval {
  id             String    @id @default(uuid())
  conversationId String    @unique
  userId         String
  /// approval | payment
  reason         String
  /// string[] — инструменты, ожидающие подтверждения.
  tools          Json
  /// {callId,toolName,entryId}[] — зарезервированные escrow-holds.
  holds          Json
  /// pending | approved | rejected | expired
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  /// Дедлайн решения: после него фоновый job отменяет hold и чистит checkpoint.
  expiresAt      DateTime?

  @@index([userId, status, createdAt])
  @@index([status, expiresAt])
}

/// Аудит изменений Control Plane: кто, что и когда изменил.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([entityType, entityId])
}
