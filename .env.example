POSTGRES_USER=skillwharf_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=skillwharf_db
JWT_SECRET=super_secret_jwt_key_change_me
PORT=3000
DATABASE_URL="postgresql://skillwharf_admin:change_me_in_production@localhost:5435/skillwharf_db?schema=public"

# LLM (OpenAI-совместимый API). Для API в compose-сети с сервисом ollama
# используйте LLM_BASE_URL=http://ollama:11434/v1.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3

# Billing (YooKassa Mock)
YOOKASSA_SHOP_ID=mock_shop_id
YOOKASSA_SECRET_KEY=mock_secret_key
YOOKASSA_RETURN_URL=http://localhost:3001/billing/success

# Sandbox: секреты для навыков, которым нужны внешние API.
# Передаются в контейнер только эти переменные (см. SANDBOX_ENV_ALLOWLIST).
TAVILY_API_KEY=mock_key
GITHUB_TOKEN=mock_token
# Egress для навыков с разрешением network. Только для локальной разработки;
# в production оставьте false (по умолчанию сеть у песочницы выключена).
SANDBOX_ALLOW_NETWORK=true
