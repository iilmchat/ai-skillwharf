POSTGRES_USER=skillwharf_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=skillwharf_db
JWT_SECRET=super_secret_jwt_key_change_me
PORT=3000
DATABASE_URL="postgresql://skillwharf_admin:change_me_in_production@localhost:5435/skillwharf_db?schema=public"

# Режим регистрации (KI-073):
#   open   — регистрация открыта всем (dev);
#   invite — только по инвайту: REGISTRATION_INVITE_CODE или одноразовый код из БД;
#   closed — новые пользователи не регистрируются (только существующие).
# Для Design Partners используйте invite и задайте мастер-код пилота.
REGISTRATION_MODE=invite
REGISTRATION_INVITE_CODE=

# LLM (OpenAI-совместимый API). Пример для локальной LM Studio:
# сервер Developer → Start Server на порту 8034, ключ — из настроек LM Studio.
# Внутри compose-сети хост доступен как host.docker.internal.
# Альтернатива — Ollama в compose: LLM_BASE_URL=http://ollama:11434/v1.
# Local LLM (LM Studio)
LLM_BASE_URL=http://host.docker.internal:8034/v1
LLM_API_KEY=your_lm_studio_api_key
LLM_MODEL=qwen2.5-coder-7b-instruct
# Резерв output-токенов на один вызов LLM: дневной жёсткий лимит
# резервируется ДО обращения к провайдеру, после ответа разница
# возвращается (reconcile). Увеличьте, если модель генерирует длинные ответы
# (по умолчанию 4096).
LLM_RESERVE_OUTPUT_TOKENS=4096
# Per-model тарифы ₽/1000 токенов (API-28.2). Переопределяются полями
# LlmRoute.inputCostPer1k/outputCostPer1k; без карты используется Legacy-ставка
# LLM_COST_PER_1K_TOKENS (0.01) для input и output.
# LLM_MODEL_PRICING_JSON={"gpt-4o":{"inputCostPer1k":0.5,"outputCostPer1k":1.5}}
# Защита от кардинальности llm_cost_total: хешировать tenant_id в короткий
# префикс t_<12 hex>. В production включено по умолчанию, в dev — выключено.
# METRICS_HASH_TENANT_ID=true

# Billing (ЮKassa). Оставьте пустыми, чтобы использовать mock-провайдер.
# Тестовые ключи: https://yookassa.ru/developers/using-api/interaction-format
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернуть пользователя после оплаты.
YOOKASSA_RETURN_URL=http://localhost:8080/app/chat?payment=success
# Периодичность проверки месячного сброса Freemium-лимитов (мс).
# Сброс идемпотентен: SkillUsage с lastResetAt из прошлых месяцев обнуляются.
FREEMIUM_RESET_INTERVAL_MS=86400000

# HITL: сколько часов ожидание подтверждения действительно, после чего
# фоновый job отменяет escrow-hold и чистит checkpoint треда; и период
# проверки просроченных ожиданий (мс).
HITL_APPROVAL_TTL_HOURS=24
HITL_EXPIRY_CHECK_INTERVAL_MS=300000

# Retention графовых checkpoint'ов: сколько дней хранить состояние
# завершённых тредов (нет активного диалога/ожидания) и период проверки (мс).
CHECKPOINT_RETENTION_DAYS=30
CHECKPOINT_RETENTION_CHECK_INTERVAL_MS=21600000

# LLM Worker: LangGraph/LangChain вынесены из API в отдельный сервис.
# В compose API ходит в llm-worker по внутренней сети; порт наружу не публикуется.
LLM_WORKER_URL=http://llm-worker:4100
# Ключ HMAC для короткоживущих (TTL 60 сек) JWT внутреннего канала
# API ↔ llm-worker. По проводу передаётся подписанный JWT, а не этот секрет.
# В production обязателен и должен быть не короче 32 символов: при пустом или
# коротком значении api и llm-worker не стартуют (fail closed).
INTERNAL_API_TOKEN=change_me_internal_token_min_32_chars
# Обратная совместимость (только dev/тесты; в production игнорируется):
# принимать статический INTERNAL_API_TOKEN наравне с JWT. По умолчанию выключено.
# ALLOW_LEGACY_INTERNAL_TOKEN=true

# Redis для BullMQ: HITL TTL, retention checkpoint'ов и уведомления.
# Пусто — API остаётся на setInterval-таймерах (dev/тесты).
REDIS_URL=redis://redis:6379
# Снапшоты финансового дашборда (`GET /finance/*`): TTL записей в секундах.
# Пусто — 7 суток. Без Redis снапшоты живут в памяти процесса API.
FINANCE_SNAPSHOT_TTL_SECONDS=604800

# YandexGPT (Yandex AI Studio). IAM-токен живёт 12 часов.
# modelUri можно задать в LlmRoute.modelName (gpt://<folder>/<model>).
# Вариант A (авто-обновление): задайте YANDEX_OAUTH_TOKEN + YANDEX_FOLDER_ID —
# адаптер сам обменяет OAuth на IAM и кэширует токен на 11 часов.
# Вариант B: статический YANDEX_IAM_TOKEN (истекает, нужно обновлять руками).
YANDEX_OAUTH_TOKEN=
YANDEX_FOLDER_ID=
YANDEX_IAM_TOKEN=

# GigaChat (Сбер). Client ID/Secret из личного кабинета разработчика.
# OAuth-токен адаптер получает сам и кэширует на 30 минут.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# Telegram Bot API (Sprint 18). Токен бота выдаёт BotFather.
TELEGRAM_BOT_TOKEN=
# Секрет webhook: то же значение передаётся Telegram при setWebhook и
# проверяется в X-Telegram-Bot-Api-Secret-Token. Сгенерируйте:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Лимит запросов webhook на IP за минуту (защита от DDoS/спама).
TELEGRAM_WEBHOOK_RATE_LIMIT=120

# Google Workspace OAuth (Sprint 18). Redirect URI должен совпадать с
# настройкой OAuth client в Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://skillwharf.example.com/api/v1/integrations/google/callback
# Отдельный секрет HMAC для OAuth-state (если пуст — используется
# TOKEN_ENCRYPTION_KEY). В production задайте независимое значение.
GOOGLE_OAUTH_STATE_SECRET=
# Через запятую; пусто — scopes по умолчанию (Sheets/Docs/Calendar).
GOOGLE_OAUTH_SCOPES=
# Календарь по умолчанию для google_calendar_create (primary или id).
GOOGLE_CALENDAR_ID=primary
# Куда вернуть браузер после OAuth (полный URL веб-приложения). Пусто —
# callback отвечает JSON { connected, scope, expiresAt }.
GOOGLE_OAUTH_SUCCESS_REDIRECT=
# Ключ шифрования refresh/access-токенов: base64 от 32 случайных байт.
# Сгенерируйте: openssl rand -base64 32
# В production — Docker secret/KMS, не коммитьте значение.
TOKEN_ENCRYPTION_KEY=
# Активный keyId в envelope `v2:<keyId>:<iv>:<tag>:<ciphertext>` (KI-053).
TOKEN_ENCRYPTION_KEY_ID=local-v1
# Предыдущие ключи только для чтения старых записей при ротации. Форматы:
#   JSON: {"local-v0":"<base64 32 байт>"}
#   CSV:  local-v0:<base64>,backup-2025:<base64>
# Перешифрование: pnpm --filter api keys:rotate (после успеха старые ключи
# можно убрать из env). Пусто — читаются только записи активного keyId.
# TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# Публичный каталог навыков (API-27.1/27.2). Реестр доверенных
# Ed25519-ключей издателей: CSV `<keyId>:<base64 SPKI>,...` либо JSON-объект
# /массив. keyId — `[a-z0-9-]{1,64}`; публичный ключ выдаёт
# `pnpm --filter api skill:keygen`.
# TRUSTED_SKILL_PUBLIC_KEYS=author-key:MCowBQYDK2VwAyEA...
# true — отклонять неподписанные сторонние навыки при установке. По умолчанию
# false (совместимость с локальными SKILL.md).
# REQUIRE_SIGNED_SKILLS=false

# Egress-политика внешних HTTP-запросов. Внешние адреса — только https и
# только перечисленные домены; локальные (host.docker.internal, compose)
# разрешены отдельно. Переопределяется в docker-compose.yml для api/worker.
API_OUTBOUND_ALLOWLIST=api.telegram.org,www.googleapis.com,oauth2.googleapis.com,sheets.googleapis.com,docs.googleapis.com,api.ttapi.io,api-performance.ozon.ru,discounts-prices-api.wildberries.ru,*.bitrix24.ru,*.moysklad.ru,ocr.api.cloud.yandex.net,api.tavily.com
LLM_WORKER_OUTBOUND_ALLOWLIST=api.telegram.org,www.googleapis.com,sheets.googleapis.com,docs.googleapis.com,oauth2.googleapis.com,api.ttapi.io,api-performance.ozon.ru,discounts-prices-api.wildberries.ru,*.bitrix24.ru,*.moysklad.ru,ocr.api.cloud.yandex.net,llm.api.cloud.yandex.net,iam.api.cloud.yandex.net,ngw.devices.sberbank.ru,gigachat.devices.sberbank.ru

# Повторы 429/5xx внешних провайдеров (Telegram, Google): экспоненциальный
# backoff; retry_after больше MAX_AFTER_MS не ждём — сразу 429.
PROVIDER_RETRY_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_MS=500
PROVIDER_RETRY_MAX_DELAY_MS=5000
PROVIDER_RETRY_MAX_AFTER_MS=30000

# Эмбеддинги для долговременной памяти (pgvector). OpenAI-совместимый
# /embeddings: OpenAI (text-embedding-3-small), LM Studio или Ollama
# (nomic-embed-text). Если BASE_URL/API_KEY пусты, берутся LLM_BASE_URL/
# LLM_API_KEY. Если модель не задана — память отключена.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# Хранилище векторов (INFRA-28.3, ADR 0002).
# pgvector (по умолчанию) — эмбеддинги в том же PostgreSQL, дополнительных
# сервисов и переменных не нужно. При росте базы переключите на qdrant:
#   VECTOR_STORE_PROVIDER=qdrant docker compose --profile qdrant up -d
# Без профиля qdrant сервис не поднимается, стек остаётся лёгким.
VECTOR_STORE_PROVIDER=pgvector
# Адрес Qdrant внутри compose-сети; наружу порт не публикуется.
# Для внешнего Qdrant задайте полный URL (https://...:6333).
QDRANT_URL=http://qdrant:6333
# API-ключ Qdrant. Секрет, храните только в .env (не коммитьте).
# Пусто — локальный Qdrant без аутентификации.
QDRANT_API_KEY=
# Коллекция для эмбеддингов памяти. При смене имени нужна миграция данных.
QDRANT_COLLECTION=skillwharf_memory

# Sandbox: секреты для навыков, которым нужны внешние API.
# Передаются в контейнер только эти переменные (см. SANDBOX_ENV_ALLOWLIST).
TAVILY_API_KEY=mock_key
GITHUB_TOKEN=mock_token
# Egress песочницы задаётся полем `egress_allowlist` в манифесте навыка
# (deny by default): глобального флага включения сети больше нет.
# Seccomp: путь к профилю внутри контейнера sandbox-worker. Пусто — профиль
# Docker по умолчанию (локальная разработка). В staging путь задаётся в
# docker-compose.staging.yml и профиль обязателен.
SANDBOX_SECCOMP_PROFILE=

# Рантайм песочницы (Sprint 25, ADR 0002). Docker — основной и дефолтный
# режим: при отсутствии SANDBOX_RUNTIME или SANDBOX_RUNTIME=docker поведение
# не отличается от прежнего. Firecracker — только опция для bare-metal /
# KVM-узлов Enterprise-клиентов; без /dev/kvm или бинарника запуск worker
# завершается ошибкой (fail closed), без фолбэка на Docker.
# SANDBOX_RUNTIME=docker
# FIRECRACKER_BIN=/usr/bin/firecracker
# FIRECRACKER_KERNEL_IMAGE=/opt/firecracker/vmlinux
# FIRECRACKER_ROOTFS_IMAGE=/opt/firecracker/rootfs.ext4
# Необязательные лимиты microVM (по умолчанию 1 vCPU / 128 MiB):
# FIRECRACKER_VCPU_COUNT=1
# FIRECRACKER_MEM_SIZE_MIB=128
# Внутренний SNI/Host-прокси песочницы (SEC-25.3). Адрес доступен изнутри
# контейнера; пусто — proxy-env в контейнер не инжектируется, а проверка
# allowlist на DNS rebinding/SSRF всё равно выполняется.
# SANDBOX_EGRESS_PROXY_URL=http://sandbox-worker:3128

# MCP-серверы маркетплейсов (docker-compose.mcp.yml).
# Ozon: Seller API (Client ID + Api-Key) и Performance API (реклама).
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=
# Wildberries: токен из seller.wildberries.ru → Настройки → Доступ к API.
WB_API_TOKEN=
# Битрикс24: Inbound Webhook вида
# https://<portal>.bitrix24.ru/rest/<user_id>/<webhook_token>/
BITRIX24_WEBHOOK_URL=
# МойСклад: Bearer-токен JSON API 1.2 и base URL (можно не менять).
MOYSKLAD_TOKEN=
MOYSKLAD_BASE_URL=https://api.moysklad.ru/api/remap/1.2
# Обязательные поля заказа покупателя МойСклада (KI-080): ID организации и
# контрагента по умолчанию. Без них moysklad_create_order отвечает 503
# errors.provider_not_configured. ID берутся из карточки сущности в МойСкладе.
MOYSKLAD_DEFAULT_ORGANIZATION_ID=
MOYSKLAD_DEFAULT_AGENT_ID=
# Live-проверка ключей при подключении (KI-075): profile.json Битрикс24 и
# GET /entity/organization МойСклада. Пропуск — только для изолированных
# окружений без внешнего API; по умолчанию проверка включена.
SKIP_INTEGRATION_LIVE_CHECK=false
# Внутренние адреса MCP-серверов (compose подставляет их в API).
BITRIX24_MCP_URL=http://bitrix24-mcp:5003
MOYSKLAD_MCP_URL=http://moysklad-mcp:5004
# Общий Bearer-токен для /sse MCP-серверов. Пусто — без авторизации
# (допустимо только во внутренней compose-сети).
MCP_AUTH_TOKEN=
# 0 — MCP healthcheck требует ключи Ozon/WB/Битрикс24/МойСклад;
# 1 — разрешить пустые ключи для локальной панели без интеграции.
MCP_ALLOW_MISSING_KEYS=0

# Документы и OCR (Sprint 20). Основной путь — Smart Document Engine
# (on-prem или облачный SDE-совместимый API) через HTTP; fallback — tesseract
# в образе skillwharf-sandbox (без внешней сети).
# Имена соответствуют коду (`OcrSmartEngineService`): SDE_BASE_URL ->
# OCR_API_URL, SDE_API_KEY -> OCR_API_KEY; отдельные SDE_* не читаются.
# Полный URL эндпоинта распознавания. Контракт: POST
# {content: base64, mimeType, language} -> {text} (или result.text,
# result.textAnnotation.fullText, data.text, pages[].text).
# Пусто — используется только tesseract.
OCR_API_URL=
OCR_API_KEY=
# Авторизация: по умолчанию Authorization: Bearer <key>; для схемы Api-Key
# задайте OCR_API_AUTH_PREFIX=Api-Key, для своего заголовка — OCR_API_AUTH_HEADER.
OCR_API_AUTH_HEADER=Authorization
OCR_API_AUTH_PREFIX=Bearer
OCR_API_TIMEOUT_MS=60000
OCR_MAX_POLL_ATTEMPTS=10
OCR_POLL_INTERVAL_MS=2000
# Локальный fallback: tesseract и лимит входного изображения.
OCR_TESSERACT_ENABLED=true
OCR_TESSERACT_LANG=rus+eng
OCR_MAX_IMAGE_BYTES=8388608

# Каталоги document-инструментов (`extract_pdf`, `write_docx`, `ocr_document`,
# `extract_document_data`). Пути внутри контейнера API: смонтируйте их в
# compose/deploy, иначе инструменты видят только пустой каталог. `path` в
# аргументах — относительный, выход за пределы каталога запрещён.
DOCUMENTS_INPUT_DIR=./documents
DOCUMENTS_OUTPUT_DIR=./docx-output
# Лимиты: размер входного файла, страниц на PDF и символов текста в ответе
# инструмента (ответ уходит в контекст модели).
DOCUMENTS_MAX_BYTES=10485760
DOCUMENTS_MAX_PAGES=50
DOCUMENTS_MAX_TEXT_CHARS=100000

# Midjourney через TTAPI (единственный разрешённый провайдер по аудиту 11.2026).
# Эндпоинты зафиксированы в коде: POST https://api.ttapi.io/midjourney/v1/imagine,
# GET https://api.ttapi.io/midjourney/v1/fetch?jobId=...; заголовок TT-API-KEY.
MIDJOURNEY_API_KEY=
MIDJOURNEY_POLL_INTERVAL_MS=2000
MIDJOURNEY_TIMEOUT_MS=120000
# Для scripts/test-integrations.sh: TTAPI fetch с тестовым jobId.
# Ожидаем 404/валидный ответ; 401 означает неверный ключ.
MIDJOURNEY_TEST_PATH=/midjourney/v1/fetch?jobId=test
MIDJOURNEY_TEST_METHOD=GET

# Ozon Seller API и Ozon Performance API (разные хосты).
OZON_API_BASE_URL=https://api-seller.ozon.ru
# Пустое тело prices=[] не меняет цены; 400/422 означает, что ключ принят.
OZON_API_TEST_PATH=/v1/product/import/prices
OZON_PERFORMANCE_API_BASE_URL=https://api-performance.ozon.ru
# WB Pricing API: отдельный хост, не marketplace-api.
WB_PRICING_API_BASE_URL=https://discounts-prices-api.wildberries.ru
WB_API_TEST_PATH=/ping

# Production/staging: домен и ACME для Caddy.
DOMAIN=skillwharf.example.com
ACME_EMAIL=admin@example.com
# Let's Encrypt staging-CA; для боевого сертификата укажите production URL.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Web UI: включить раздел «Память» (RAG) в Docker-сборке. Vite вшивает
# значение флага на этапе сборки, поэтому после изменения нужен
# `docker compose build web`. По умолчанию раздел скрыт (false).
# VITE_RAG_MEMORY_ENABLED=true

# Web UI: контакты и поддержка на лендинге. Вшиваются в бандл при сборке,
# секретов тут нет.
# VITE_CONTACT_EMAIL=skillwharf@iiruchating.ru
# VITE_CLOUDTIPS_URL=            # пусто = секция «Поддержка» скрыта
# VITE_CLOUDTIPS_QR=/qr-cloudtips.svg
# База приложения для статического лендинга (`pnpm build:landing`): кнопки
# входа и офиса ведут туда. Пусто = тот же origin.
# VITE_APP_URL=https://app.skillwharf.ru

# Мониторинг (профиль monitoring). Пароли и хэши задаются только в .env.
# Логин/пароль HTTP Basic Auth для Prometheus и путей /grafana/, /prometheus/.
# Пароль — без символа `$`: Grafana provisioning повторно интерпретирует `$`.
MONITORING_BASIC_AUTH_USER=monitoring
MONITORING_BASIC_AUTH_PASSWORD=
# bcrypt-хэш того же пароля. Сгенерируйте (пароль не попадёт в git):
#   read -rs -p 'Password: ' P; echo
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext "$P"
# Значение содержит `$`, поэтому в .env его нужно заключить в одинарные кавычки:
#   MONITORING_BASIC_AUTH_HASH='$2a$...'
MONITORING_BASIC_AUTH_HASH=

# Вход в саму Grafana. admin/admin не используется: пароль обязателен.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Опциональный OIDC/OAuth2 для Grafana (INFRA-26.3, KI-018).
# Пустой GRAFANA_OIDC_ENABLED (или false) = только Basic Auth (fallback),
# поэтому существующие установки продолжают работать. При включённом OIDC
# Basic остаётся доступным, пока GRAFANA_BASIC_AUTH_ENABLED не выставлен в false.
# Секрет client_secret храните только в .env, не коммитьте.
GRAFANA_OIDC_ENABLED=false
GRAFANA_OIDC_NAME=SSO
GRAFANA_OIDC_CLIENT_ID=
GRAFANA_OIDC_CLIENT_SECRET=
GRAFANA_OIDC_AUTH_URL=
GRAFANA_OIDC_TOKEN_URL=
# API_URL (userinfo) опционален в зависимости от провайдера.
GRAFANA_OIDC_API_URL=
GRAFANA_OIDC_SCOPES=openid email profile
# true разрешает провайдеру назначать роль admin — включайте осознанно.
GRAFANA_OIDC_ALLOW_ADMIN=false
GRAFANA_BASIC_AUTH_ENABLED=true

# Бэкапы БД (scripts/backup-db.sh, scripts/rotate-backups.sh).
# Хранить BACKUP_KEEP_DAYS дней, но всегда оставлять не меньше
# BACKUP_KEEP_MIN последних дампов. Минимум свободного места перед дампом.
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MIN=7
BACKUP_MIN_FREE_MB=512

# Offsite-бэкапы (S3-совместимое хранилище) через rclone.
# Пусто в BACKUP_S3_BUCKET — offsite выключен, локальные бэкапы работают
# как раньше. Секреты храните только в .env, не в git.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=
# По умолчанию равно BACKUP_KEEP_DAYS.
BACKUP_S3_KEEP_DAYS=
# Клиентское шифрование offsite-дампов (INFRA-26.4, KI-035).
# Пусто — дамп выгружается в открытом виде (по-прежнему с SSE-S3 AES256).
# Не пусто — дамп шифруется openssl AES-256-CBC/PBKDF2 (iter 100000) в .enc;
# тот же ключ понадобится restore-drill.sh. Передаётся openssl через env,
# не в аргументах командной строки. Храните ключ только в .env (права 600).
BACKUP_ENCRYPTION_KEY=
# Образ для restore-drill.sh (изолированный контейнер, --network none).
# По умолчанию pgvector/pgvector:pg17: боевые дампы содержат расширение
# vector, которого нет в базовом postgres:17-alpine. Для дампов без vector
# можно указать RESTORE_DRILL_IMAGE=postgres:17-alpine.
RESTORE_DRILL_IMAGE=pgvector/pgvector:pg17

# Observability: OTel Collector и Grafana Tempo (профиль monitoring).
# Пусто — API не запускает OTel SDK и не экспортирует спаны.
# Для локального коллектора: http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=skillwharf-api
# OTel Collector дополнительно шлёт спаны в Tempo (tempo:4317) и хранит их
# 7 дней в томе tempo_data. Дополнительных переменных для Tempo не нужно:
# конфигурация лежит в infra/tempo/tempo-config.yaml.


# Sentry отключён, пока SENTRY_DSN пуст. DSN — секрет, храните только в .env.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
