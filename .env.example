POSTGRES_USER=skillwharf_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=skillwharf_db
JWT_SECRET=super_secret_jwt_key_change_me
PORT=3000
DATABASE_URL="postgresql://skillwharf_admin:change_me_in_production@localhost:5435/skillwharf_db?schema=public"

# LLM (OpenAI-совместимый API). Пример для локальной LM Studio:
# сервер Developer → Start Server на порту 8034, ключ — из настроек LM Studio.
# Внутри compose-сети хост доступен как host.docker.internal.
# Альтернатива — Ollama в compose: LLM_BASE_URL=http://ollama:11434/v1.
# Local LLM (LM Studio)
LLM_BASE_URL=http://host.docker.internal:8034/v1
LLM_API_KEY=your_lm_studio_api_key
LLM_MODEL=qwen2.5-coder-7b-instruct
# Резерв output-токенов на один вызов LLM: дневной жёсткий лимит
# резервируется ДО обращения к провайдеру, после ответа разница
# возвращается (reconcile). Увеличьте, если модель генерирует длинные ответы
# (по умолчанию 4096).
LLM_RESERVE_OUTPUT_TOKENS=4096

# Billing (ЮKassa). Оставьте пустыми, чтобы использовать mock-провайдер.
# Тестовые ключи: https://yookassa.ru/developers/using-api/interaction-format
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернуть пользователя после оплаты.
YOOKASSA_RETURN_URL=http://localhost:8080/app/chat?payment=success
# Периодичность проверки месячного сброса Freemium-лимитов (мс).
# Сброс идемпотентен: SkillUsage с lastResetAt из прошлых месяцев обнуляются.
FREEMIUM_RESET_INTERVAL_MS=86400000

# HITL: сколько часов ожидание подтверждения действительно, после чего
# фоновый job отменяет escrow-hold и чистит checkpoint треда; и период
# проверки просроченных ожиданий (мс).
HITL_APPROVAL_TTL_HOURS=24
HITL_EXPIRY_CHECK_INTERVAL_MS=300000

# Retention графовых checkpoint'ов: сколько дней хранить состояние
# завершённых тредов (нет активного диалога/ожидания) и период проверки (мс).
CHECKPOINT_RETENTION_DAYS=30
CHECKPOINT_RETENTION_CHECK_INTERVAL_MS=21600000

# LLM Worker: LangGraph/LangChain вынесены из API в отдельный сервис.
# В compose API ходит в llm-worker по внутренней сети; порт наружу не публикуется.
LLM_WORKER_URL=http://llm-worker:4100
# Общий секрет внутренней сети API ↔ llm-worker. Публичный трафик им не
# аутентифицируется; в production задайте случайное значение.
INTERNAL_API_TOKEN=change_me_internal_token

# Redis для BullMQ: HITL TTL, retention checkpoint'ов и уведомления.
# Пусто — API остаётся на setInterval-таймерах (dev/тесты).
REDIS_URL=redis://redis:6379

# YandexGPT (Yandex AI Studio). IAM-токен живёт 12 часов.
# modelUri можно задать в LlmRoute.modelName (gpt://<folder>/<model>).
# Вариант A (авто-обновление): задайте YANDEX_OAUTH_TOKEN + YANDEX_FOLDER_ID —
# адаптер сам обменяет OAuth на IAM и кэширует токен на 11 часов.
# Вариант B: статический YANDEX_IAM_TOKEN (истекает, нужно обновлять руками).
YANDEX_OAUTH_TOKEN=
YANDEX_FOLDER_ID=
YANDEX_IAM_TOKEN=

# GigaChat (Сбер). Client ID/Secret из личного кабинета разработчика.
# OAuth-токен адаптер получает сам и кэширует на 30 минут.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# Эмбеддинги для долговременной памяти (pgvector). OpenAI-совместимый
# /embeddings: OpenAI (text-embedding-3-small), LM Studio или Ollama
# (nomic-embed-text). Если BASE_URL/API_KEY пусты, берутся LLM_BASE_URL/
# LLM_API_KEY. Если модель не задана — память отключена.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# Sandbox: секреты для навыков, которым нужны внешние API.
# Передаются в контейнер только эти переменные (см. SANDBOX_ENV_ALLOWLIST).
TAVILY_API_KEY=mock_key
GITHUB_TOKEN=mock_token
# Egress песочницы задаётся полем `egress_allowlist` в манифесте навыка
# (deny by default): глобального флага включения сети больше нет.
# Seccomp: путь к профилю внутри контейнера sandbox-worker. Пусто — профиль
# Docker по умолчанию (локальная разработка). В staging путь задаётся в
# docker-compose.staging.yml и профиль обязателен.
SANDBOX_SECCOMP_PROFILE=

# MCP-серверы маркетплейсов (docker-compose.mcp.yml).
# Ozon: Seller API (Client ID + Api-Key) и Performance API (реклама).
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=
# Wildberries: токен из seller.wildberries.ru → Настройки → Доступ к API.
WB_API_TOKEN=
# Общий Bearer-токен для /sse MCP-серверов. Пусто — без авторизации
# (допустимо только во внутренней compose-сети).
MCP_AUTH_TOKEN=

# Production/staging: домен и ACME для Caddy.
DOMAIN=skillwharf.example.com
ACME_EMAIL=admin@example.com
# Let's Encrypt staging-CA; для боевого сертификата укажите production URL.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Web UI: включить раздел «Память» (RAG) в Docker-сборке. Vite вшивает
# значение флага на этапе сборки, поэтому после изменения нужен
# `docker compose build web`. По умолчанию раздел скрыт (false).
# VITE_RAG_MEMORY_ENABLED=true

# Мониторинг (профиль monitoring). Пароли и хэши задаются только в .env.
# Логин/пароль HTTP Basic Auth для Prometheus и путей /grafana/, /prometheus/.
# Пароль — без символа `$`: Grafana provisioning повторно интерпретирует `$`.
MONITORING_BASIC_AUTH_USER=monitoring
MONITORING_BASIC_AUTH_PASSWORD=
# bcrypt-хэш того же пароля. Сгенерируйте (пароль не попадёт в git):
#   read -rs -p 'Password: ' P; echo
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext "$P"
# Значение содержит `$`, поэтому в .env его нужно заключить в одинарные кавычки:
#   MONITORING_BASIC_AUTH_HASH='$2a$...'
MONITORING_BASIC_AUTH_HASH=

# Вход в саму Grafana. admin/admin не используется: пароль обязателен.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Бэкапы БД (scripts/backup-db.sh, scripts/rotate-backups.sh).
# Хранить BACKUP_KEEP_DAYS дней, но всегда оставлять не меньше
# BACKUP_KEEP_MIN последних дампов. Минимум свободного места перед дампом.
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MIN=7
BACKUP_MIN_FREE_MB=512

# Offsite-бэкапы (S3-совместимое хранилище) через rclone.
# Пусто в BACKUP_S3_BUCKET — offsite выключен, локальные бэкапы работают
# как раньше. Секреты храните только в .env, не в git.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=
# По умолчанию равно BACKUP_KEEP_DAYS.
BACKUP_S3_KEEP_DAYS=

# Observability: OTel Collector (профиль monitoring).
# Пусто — API не запускает OTel SDK и не экспортирует спаны.
# Для локального коллектора: http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=skillwharf-api

# Sentry отключён, пока SENTRY_DSN пуст. DSN — секрет, храните только в .env.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
