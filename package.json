{
  "name": "ai-skillwharf",
  "version": "0.1.0",
  "private": true,
  "description": "SkillWharf — монорепозиторий (NestJS + pnpm workspaces)",
  "main": "index.js",
  "scripts": {
    "lint": "oxlint .",
    "lint:docs": "markdownlint-cli2 \"*.md\" \"docs/**/*.md\"",
    "format": "prettier --write .",
    "build:api": "pnpm --filter api build",
    "build:llm-worker": "pnpm --filter llm-worker build",
    "openapi:export": "pnpm --filter api openapi:export",
    "db:seed:demo": "pnpm --filter api db:seed:demo",
    "test": "pnpm --filter @skillwharf/shared build && vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "seed:staging": "node --env-file-if-exists=.env --experimental-transform-types scripts/seed-staging.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "markdownlint-cli2": "^0.24.0",
    "oxlint": "^1.93.0",
    "prettier": "3.9.6",
    "vitest": "^5.1.0",
    "zod": "^3.25.76",
    "@types/node": "^24.10.1"
  }
}
